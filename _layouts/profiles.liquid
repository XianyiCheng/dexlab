---
layout: page
---
<div class="post">
  <article>
    {% if page.profiles %}
      {% for group in page.profiles %}
        <h2 style="margin-top: 2rem; margin-bottom: 1rem;">{{ group.title }}</h2>
        {% if group.list %}
        <ul style="margin-bottom: 3rem;">
          {% for member in group.members %}
            <li style="margin-bottom: 0.5rem;">
              {% if member.url %}
                <a href="{{ member.url }}" target="_blank">{{ member.name }}</a>
              {% else %}
                {{ member.name }}
              {% endif %}{% if member.position %}, {{ member.position }}{% endif %}{% if member.next %} &rarr; {{ member.next }}{% endif %}
            </li>
          {% endfor %}
        </ul>
        {% else %}
        <div style="display: flex; flex-wrap: wrap; gap: 2rem; margin-bottom: 3rem;">
          {% for member in group.members %}
            <div style="width: 180px; text-align: center;">
              {% if member.image %}
                <img
                  src="{{ 'assets/img/' | append: member.image | relative_url }}"
                  alt="{{ member.name }}"
                  class="z-depth-1"
                  style="width: 150px; height: 150px; object-fit: cover; margin-bottom: 0.5rem; border-radius: 8px;"
                >
              {% endif %}
              {% if member.url %}
                <div style="font-size: 1rem;">
                  <a href="{{ member.url }}" target="_blank">
                    {{ member.name }}
                  </a>
                </div>
              {% else %}
                <div style="font-size: 1rem;">{{ member.name }}</div>
              {% endif %}
              <div style="font-size: 1rem;">{{ member.position }}</div>
            </div>
          {% endfor %}
        </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </article>
</div>

{{ content }}
